# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# La suite de tests tourne sur SQLite : pas de serveur à installer, base
# recréée à chaque classe de test, exécution en quelques secondes.
#
# Attention : SQLite et MySQL ne se comportent pas à l'identique. SQLite rend
# « 600 » là où MySQL rend « 600.00 » sur un NUMERIC, et son LIKE ne sait
# ignorer la casse que sur l'ASCII. Les tests en tiennent compte, mais une
# vérification sur MySQL avant mise en production reste recommandée :
#   DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/vite_gourmand_test?serverVersion=8.0.32&charset=utf8mb4" vendor/bin/phpunit
DATABASE_URL="sqlite:///%kernel.project_dir%/var/test.db"
