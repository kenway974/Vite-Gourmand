{% extends 'base.html.twig' %}

{% block title %}Accès refusé — Vite &amp; Gourmand{% endblock %}

{% block body %}
    <h1>Vous n'avez pas accès à cette page</h1>

    <p>
        {% if app.user %}
            Votre compte ne dispose pas des droits nécessaires. Si vous pensez
            que c'est une erreur, écrivez-nous.
        {% else %}
            Cette page demande d'être connecté.
        {% endif %}
    </p>

    <ul>
        {% if not app.user %}
            <li><a href="{{ path('app_login') }}">Se connecter</a></li>
        {% endif %}
        <li><a href="{{ path('app_home') }}">Retour à l'accueil</a></li>
        <li><a href="{{ path('app_contact') }}">Nous écrire</a></li>
    </ul>
{% endblock %}
