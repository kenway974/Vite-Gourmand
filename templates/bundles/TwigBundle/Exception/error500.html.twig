{% extends 'bundles/TwigBundle/Exception/_socle.html.twig' %}
{% import 'composants/macros.html.twig' as ui %}

{% block title %}Une erreur est survenue — Vite &amp; Gourmand{% endblock %}

{% block body %}
    {{ ui.surtitre('Erreur 500') }}
    <h1>Une erreur est survenue de notre côté</h1>

    {# Aucun détail technique : un message d'exception peut révéler la
       structure de la base ou des chemins de fichiers. #}
    <p class="chapeau" style="margin-inline: auto">
        Le problème vient de nous, pas de vous. Il a été enregistré et nous
        allons le regarder.
    </p>

    <p>
        Si vous étiez en train de passer une commande, elle n'a pas été
        enregistrée : reprenez depuis le menu concerné.
    </p>

    <div class="banniere__actions">
        {{ ui.bouton('Retour à l\'accueil', '/', 'principal') }}
        {{ ui.bouton('Décrire ce qui s\'est passé', '/contact', 'contour') }}
    </div>
{% endblock %}
