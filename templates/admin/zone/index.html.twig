{% extends 'admin/_layout.html.twig' %}
{% import 'composants/macros.html.twig' as ui %}

{% block title %}Zones de livraison — Administration{% endblock %}

{% block corps_admin %}
    <h1>Zones de livraison</h1>

    <p>
        Un code postal absent de cette liste n'est pas desservi : la commande
        est refusée et le client est invité à demander un devis.
    </p>

    <p>{{ ui.bouton('Ajouter une commune', path('app_admin_zone_new'), 'principal') }}</p>

    {% if elements is empty %}
        <p role="alert">
            <strong>Aucune zone définie :</strong> aucune commande ne peut aboutir
            tant qu'au moins une commune n'est pas desservie.
        </p>
    {% else %}
        <div class="tableau-defilant">
            <table>
            <caption>Communes desservies ({{ elements|length }})</caption>
            <thead>
                <tr>
                    <th scope="col">Commune</th>
                    <th scope="col">Code postal</th>
                    <th scope="col">Supplément</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for element in elements %}
                    <tr>
                        <th scope="row">{{ element.commune }}</th>
                        <td>{{ element.codePostal }}</td>
                        <td>{{ element.livraisonComprise ? 'Livraison comprise' : element.frais ~ ' €' }}</td>
                        <td>
                            <a href="{{ path('app_admin_zone_edit', {id: element.id}) }}">Modifier</a>

                            <form method="post"
                                  action="{{ path('app_admin_zone_delete', {id: element.id}) }}"
                                  onsubmit="return confirm('Cesser de livrer {{ element.commune|e('js') }} ?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('supprimer-zone-' ~ element.id) }}">
                                <button type="submit">Retirer<span class="sr-only"> {{ element.commune }}</span></button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        </div>
    {% endif %}

    <p><a href="{{ path('app_admin') }}">Retour à l'administration</a></p>
{% endblock %}
