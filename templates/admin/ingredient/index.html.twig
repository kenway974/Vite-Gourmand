{% extends 'admin/_layout.html.twig' %}
{% import 'composants/macros.html.twig' as ui %}

{% block title %}Ingrédients — Administration{% endblock %}

{% block corps_admin %}
    <h1>Ingrédients</h1>

    <p>{{ ui.bouton('Ajouter un ingrédient', path('app_admin_ingredient_new'), 'principal') }}</p>

    {% if elements is empty %}
        <p>Aucun ingrédient pour le moment.</p>
    {% else %}
        <div class="tableau-defilant">
            <table>
            <caption>Liste des ingrédients ({{ elements|length }})</caption>
            <thead>
                <tr>
                    <th scope="col">Nom</th>
                    <th scope="col">Allergènes</th>
                    <th scope="col">Plats</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for ligne in elements %}
                    {% set element = ligne.entite %}
                    <tr>
                        <th scope="row">{{ element.nom }}</th>
                        <td>{{ ligne.nbAllergenes }}</td>
                        <td>{{ ligne.nbPlats }}</td>
                        <td>
                            <a href="{{ path('app_admin_ingredient_edit', {id: element.id}) }}">Modifier</a>

                            <form method="post"
                                  action="{{ path('app_admin_ingredient_delete', {id: element.id}) }}"
                                  onsubmit="return confirm('Supprimer définitivement « {{ element.nom|e('js') }} » ?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('supprimer-ingredient-' ~ element.id) }}">
                                <button type="submit">Supprimer<span class="sr-only"> ingrédient {{ element.nom }}</span></button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        </div>
    {% endif %}

    <p><a href="{{ path('app_admin') }}">Retour à l'administration</a></p>
{% endblock %}
