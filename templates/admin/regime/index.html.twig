{% extends 'admin/_layout.html.twig' %}
{% import 'composants/macros.html.twig' as ui %}

{% block title %}Régimes — Administration{% endblock %}

{% block corps_admin %}
    <h1>Régimes</h1>

    <p>{{ ui.bouton('Ajouter un régime', path('app_admin_regime_new'), 'principal') }}</p>

    {% if elements is empty %}
        <p>Aucun régime pour le moment.</p>
    {% else %}
        <div class="tableau-defilant">
            <table>
            <caption>Liste des régimes ({{ elements|length }})</caption>
            <thead>
                <tr>
                    <th scope="col">Libellé</th>
                    <th scope="col">Description</th>
                    <th scope="col">Menus</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for ligne in elements %}
                    {% set element = ligne.entite %}
                    <tr>
                        <th scope="row">{{ element.libelle }}</th>
                        <td>{{ element.description|default("—") }}</td>
                        <td>{{ ligne.nbMenus }}</td>
                        <td>
                            <a href="{{ path('app_admin_regime_edit', {id: element.id}) }}">Modifier</a>

                            <form method="post"
                                  action="{{ path('app_admin_regime_delete', {id: element.id}) }}"
                                  onsubmit="return confirm('Supprimer définitivement « {{ element.libelle|e('js') }} » ?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('supprimer-regime-' ~ element.id) }}">
                                <button type="submit">Supprimer<span class="sr-only"> régime {{ element.libelle }}</span></button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        </div>
    {% endif %}

    <p><a href="{{ path('app_admin') }}">Retour à l'administration</a></p>
{% endblock %}
