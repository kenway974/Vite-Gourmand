{% extends 'base.html.twig' %}

{% block title %}Horaires — Administration{% endblock %}

{% block body %}
    <h1>Horaires d'ouverture</h1>

    {% if joursLibres is not empty %}
        <p><a href="{{ path('app_admin_horaire_new') }}">Renseigner un jour</a></p>
        <p role="alert">
            Jour(s) non renseigné(s) : {{ joursLibres|join(', ') }}. Ces jours n'apparaissent pas
            dans les horaires publiés.
        </p>
    {% endif %}

    {% if elements is empty %}
        <p>Aucun horaire renseigné pour le moment.</p>
    {% else %}
        <table>
            <caption>Semaine type ({{ elements|length }} jour(s) renseigné(s))</caption>
            <thead>
                <tr>
                    <th scope="col">Jour</th>
                    <th scope="col">Ouverture</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for element in elements %}
                    <tr>
                        <th scope="row">{{ element.jour }}</th>
                        <td>{{ element.plage }}</td>
                        <td>
                            <a href="{{ path('app_admin_horaire_edit', {id: element.id}) }}">Modifier</a>

                            <form method="post"
                                  action="{{ path('app_admin_horaire_delete', {id: element.id}) }}"
                                  onsubmit="return confirm('Retirer « {{ element.jour|e('js') }} » des horaires publiés ?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('supprimer-horaire-' ~ element.id) }}">
                                <button type="submit">Retirer<span class="sr-only"> le {{ element.jour }}</span></button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    <p><a href="{{ path('app_admin') }}">Retour à l'administration</a></p>
{% endblock %}
