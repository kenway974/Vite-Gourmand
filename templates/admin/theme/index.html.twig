{% extends 'base.html.twig' %}

{% block title %}Thèmes — Administration{% endblock %}

{% block body %}
    <h1>Thèmes</h1>

    <p><a href="{{ path('app_admin_theme_new') }}">Ajouter un thème</a></p>

    {% if elements is empty %}
        <p>Aucun thème pour le moment.</p>
    {% else %}
        <table>
            <caption>Liste des thèmes ({{ elements|length }})</caption>
            <thead>
                <tr>
                    <th scope="col">Libellé</th>
                    <th scope="col">Description</th>
                    <th scope="col">Menus</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for ligne in elements %}
                    {% set element = ligne.entite %}
                    <tr>
                        <th scope="row">{{ element.libelle }}</th>
                        <td>{{ element.description|default("—") }}</td>
                        <td>{{ ligne.nbMenus }}</td>
                        <td>
                            <a href="{{ path('app_admin_theme_edit', {id: element.id}) }}">Modifier</a>

                            <form method="post"
                                  action="{{ path('app_admin_theme_delete', {id: element.id}) }}"
                                  onsubmit="return confirm('Supprimer définitivement « {{ element.libelle|e('js') }} » ?')">
                                <input type="hidden" name="_token" value="{{ csrf_token('supprimer-theme-' ~ element.id) }}">
                                <button type="submit">Supprimer<span class="sr-only"> thème {{ element.libelle }}</span></button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% endif %}

    <p><a href="{{ path('app_admin') }}">Retour à l'administration</a></p>
{% endblock %}
