{% extends 'base.html.twig' %}

{% block title %}Changer mon mot de passe — Vite &amp; Gourmand{% endblock %}

{% block body %}
    <h1>Changer mon mot de passe</h1>

    {{ form_errors(form) }}

    {{ form_start(form) }}
        {{ form_row(form.actuel) }}
        {{ form_row(form.nouveau.first) }}
        {{ form_row(form.nouveau.second) }}
        <button type="submit">Changer le mot de passe</button>
    {{ form_end(form) }}

    <p><a href="{{ path('app_compte') }}">Retour à mon compte</a></p>
{% endblock %}
