{% extends 'base.html.twig' %}
{% import 'composants/macros.html.twig' as ui %}

{% block title %}Mon compte — Vite &amp; Gourmand{% endblock %}

{% block banniere %}
    <div class="banniere banniere--courte">
        <div class="conteneur banniere__contenu">
            {{ ui.surtitre('Espace client') }}
            <h1>Mon compte</h1>
        </div>
    </div>
{% endblock %}

{% block body %}
    <div class="bande conteneur conteneur--etroit">
        <div class="carte">
            <dl class="fiche">
                <div>
                    <dt>Nom</dt>
                    <dd>{{ app.user.prenom }} {{ app.user.nom }}</dd>
                </div>
                <div>
                    <dt>Adresse e-mail</dt>
                    <dd>{{ app.user.userIdentifier }}</dd>
                </div>
                <div>
                    <dt>Téléphone</dt>
                    <dd>{{ app.user.gsm|default('Non renseigné') }}</dd>
                </div>
                <div>
                    <dt>Adresse postale</dt>
                    <dd>{{ app.user.adressePostale|default('Non renseignée') }}</dd>
                </div>
            </dl>
        </div>

        <div class="actions">
            {{ ui.bouton('Modifier mes coordonnées', path('app_compte_modifier'), 'contour') }}
            {{ ui.bouton('Changer mon mot de passe', path('app_compte_mot_de_passe'), 'contour') }}
            {{ ui.bouton('Mes commandes', path('app_client_commandes'), 'contour') }}
        </div>

        <p style="margin-top: 2rem">
            <a href="{{ path('app_compte_suppression') }}" class="lien-discret">Supprimer mon compte</a>
        </p>
    </div>
{% endblock %}
