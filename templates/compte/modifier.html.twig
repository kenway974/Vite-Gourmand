{% extends 'base.html.twig' %}
{% import 'composants/macros.html.twig' as ui %}

{% block title %}Modifier mes coordonnées — Vite &amp; Gourmand{% endblock %}

{% block banniere %}
    <div class="banniere banniere--courte">
        <div class="conteneur banniere__contenu">
            {{ ui.surtitre('Espace client') }}
            <h1>Modifier mes coordonnées</h1>
        </div>
    </div>
{% endblock %}

{% block body %}
    <div class="bande conteneur conteneur--etroit">
        <div class="carte carte--relief">
            {{ form_errors(form) }}

            {{ form_start(form) }}
                {{ form_row(form.prenom) }}
                {{ form_row(form.nom) }}
                {{ form_row(form.email) }}
                {{ form_row(form.gsm) }}
                {{ form_row(form.adressePostale) }}
                {{ ui.bouton('Enregistrer', null, 'principal', {large: true, type: 'submit'}) }}
            {{ form_end(form) }}
        </div>

        <p class="centre" style="margin-top: 1.5rem">
            <a href="{{ path('app_compte') }}">Retour à mon compte</a>
        </p>
    </div>
{% endblock %}
