{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe — Vite &amp; Gourmand{% endblock %}

{% block body %}
    <h1>Choisir un nouveau mot de passe</h1>

    {{ form_errors(form) }}

    {{ form_start(form) }}
        {{ form_row(form.nouveau.first) }}
        {{ form_row(form.nouveau.second) }}
        <button type="submit">Enregistrer le nouveau mot de passe</button>
    {{ form_end(form) }}
{% endblock %}
