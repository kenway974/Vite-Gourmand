{% extends 'base.html.twig' %}

{% block title %}Nous écrire — Vite &amp; Gourmand{% endblock %}

{% block body %}
    <h1>Nous écrire</h1>

    <p>Dites-nous votre événement et le nombre de convives, nous vous répondons sous 48 heures.</p>

    {{ form_errors(form) }}

    {{ form_start(form) }}
        {{ form_row(form.titre) }}
        {{ form_row(form.email) }}
        {{ form_row(form.message) }}

        <button type="submit">Envoyer</button>
    {{ form_end(form) }}
{% endblock %}
