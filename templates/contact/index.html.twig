{% extends 'base.html.twig' %}
{% import 'composants/macros.html.twig' as ui %}

{% block title %}Nous écrire — Vite &amp; Gourmand{% endblock %}

{% block banniere %}
    <div class="banniere banniere--courte">
        <div class="conteneur banniere__contenu">
            {{ ui.surtitre('Contact') }}
            <h1>Nous écrire</h1>
        </div>
    </div>
{% endblock %}

{% block body %}
    <div class="bande conteneur conteneur--etroit">
        <p class="chapeau" style="margin-inline: auto; text-align: center">
            Dites-nous votre événement et le nombre de convives, nous vous
            répondons sous 48 heures.
        </p>

        <div class="carte carte--relief" style="margin-top: 2rem">
            {{ form_errors(form) }}

            {{ form_start(form) }}
                {{ form_row(form.titre) }}
                {{ form_row(form.email) }}
                {{ form_row(form.message) }}

                {{ ui.bouton('Envoyer', null, 'principal', {large: true, type: 'submit'}) }}
            {{ form_end(form) }}
        </div>
    </div>
{% endblock %}
