{% extends 'base.html.twig' %}

{% block title %}Mon compte — Vite &amp; Gourmand{% endblock %}

{% block body %}
    {# Gabarit provisoire — les espaces utilisateur / employé / admin restent à construire. #}
    <h1>Mon compte</h1>

    <dl>
        <dt>Nom</dt>
        <dd>{{ app.user.prenom }} {{ app.user.nom }}</dd>

        <dt>Adresse e-mail</dt>
        <dd>{{ app.user.userIdentifier }}</dd>

        <dt>Rôles</dt>
        <dd>{{ app.user.roles|join(', ') }}</dd>
    </dl>
{% endblock %}
